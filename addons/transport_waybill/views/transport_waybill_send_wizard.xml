<odoo>

    <record id="view_transport_waybill_send_wizard_form" model="ir.ui.view">
        <field name="name">transport_waybill.send.wizard.form</field>
        <field name="model">transport_waybill.send.wizard</field>
        <!-- <field name="inherit_id" ref=""/> -->
        <!-- <field name="mode">primary</field> -->
        <field name="arch" type="xml">
            <form string="Send Waybill">
                <group>

                    <field name="waybill_id"/>

                    <field name="driver_id"/>

                    <field name="vehicle_id"/>

                    <separator string="Delivery"/>

                    <field name="send_telegram"/>

                    <field name="send_max"/>

                    <field name="send_email"/>

                </group>

                <footer>

                    <button
                        name="action_send"
                        type="object"
                        string="Send"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>
        </field>
    </record>

</odoo>