<odoo>
    <record id="view_transport_waybill_list" model="ir.ui.view">
        <field name="name">transport_waybill.waybill.list</field>
        <field name="model">transport_waybill.waybill</field>
        <field name="arch" type="xml">
            <list string="Waybills">
                <field name="name"/>
                <field name="date"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_transport_waybill_form" model="ir.ui.view">
        <field name="name">transport_waybill.waybill.form</field>
        <field name="model">transport_waybill.waybill</field>
        <!-- <field name="inherit_id" ref=""/> -->
        <!-- <field name="mode">primary</field> -->
        <field name="arch" type="xml">
            <form string="Waybill">
                <header>

                    <button
                        name="action_preview_report"
                        type="object"
                        string="View / Download"
                        class="btn-secondary"
                    />

                    <button
                        name="action_open_send_wizard"
                        type="object"
                        string="Send"
                        class="btn-primary"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,sent"
                    />

                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="date"/>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                        </group>

                        <group>
                            <field name="state"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Document">

                            <group>
                                <field
                                    name="document"
                                    filename="document_filename"
                                />
                                <field name="document_filename" invisible="1"/>
                            </group>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transport_waybill_waybill" model="ir.actions.act_window">
        <field name="name">Waybills</field>
        <field name="res_model">transport_waybill.waybill</field>
        <!-- <field name="path"></field> -->
        <!-- <field name="search_view_id" ref=""/> -->
        <!-- <field name="context">{
            'search_default_': 1,
        }</field> -->
        <field name="view_mode">list,form</field>
    </record>
</odoo>