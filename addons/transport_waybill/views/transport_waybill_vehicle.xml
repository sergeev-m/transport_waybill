<odoo>
    <record id="view_transport_waybill_vehicle_list" model="ir.ui.view">
        <field name="name">transport_waybill.vehicle.list</field>
        <field name="model">transport_waybill.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
            </list>
        </field>
    </record>

    <record id="view_transport_waybill_vehicle_form" model="ir.ui.view">
        <field name="name">transport_waybill.form</field>
        <field name="model">transport_waybill.vehicle</field>
        <!-- <field name="inherit_id" ref=""/> -->
        <!-- <field name="mode">primary</field> -->
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="license_plate"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transport_waybill_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">transport_waybill.vehicle</field>
        <!-- <field name="path"></field> -->
        <!-- <field name="search_view_id" ref=""/> -->
        <!-- <field name="context">{
            'search_default_': 1,
        }</field> -->
        <field name="view_mode">list,form</field>
    </record>
</odoo>