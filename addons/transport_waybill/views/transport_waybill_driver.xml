<odoo>
    <record id="view_transport_waybill_driver_list" model="ir.ui.view">
        <field name="name">transport_waybill.driver.list</field>
        <field name="model">transport_waybill.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="telegram_user_id"/>
                <field name="vehicle_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_transport_waybill_driver_form" model="ir.ui.view">
        <field name="name">transport_waybill.driver.form</field>
        <field name="model">transport_waybill.driver</field>
        <!-- <field name="inherit_id" ref=""/> -->
        <!-- <field name="mode">primary</field> -->
        <field name="arch" type="xml">
            <form string="Driver">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="phone"/>
                        </group>

                        <group>
                            <field name="telegram_user_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Vehicles">
                            <field name="vehicle_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="license_plate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>`
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transport_waybill_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">transport_waybill.driver</field>
        <!-- <field name="path"></field> -->
        <!-- <field name="search_view_id" ref=""/> -->
        <!-- <field name="context">{
            'search_default_': 1,
        }</field> -->
        <field name="view_mode">list,form</field>
    </record>
</odoo>