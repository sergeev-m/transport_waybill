<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_waybill" model="ir.actions.report">
        <field name="name">Waybill</field>
        <field name="model">transport_waybill.waybill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_waybill.report_waybill</field>
        <field name="report_file">transport_waybill.report_waybill</field>
        <field name="binding_model_id" ref="model_transport_waybill_waybill"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_waybill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>Путевой лист</h2>

                        <p>
                            <strong>Дата:</strong>
                            <span t-field="o.date"/>
                        </p>

                        <p>
                            <strong>Водитель:</strong>
                            <span t-field="o.driver_id"/>
                        </p>

                        <p>
                            <strong>Автомобиль:</strong>
                            <span t-field="o.vehicle_id"/>
                        </p>

                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
